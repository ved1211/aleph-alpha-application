---
type Owner = "research" | "engineering" | "communications" | "legal";
const ownerLabel: Record<Owner, string> = {
  research: "Research",
  engineering: "Engineering",
  communications: "Communications",
  legal: "Legal",
};

const phases: { title: string; tasks: { task: string; owner: Owner }[] }[] = [
  {
    title: "Two weeks before",
    tasks: [
      { task: "Freeze results", owner: "research" },
      { task: "Check license", owner: "legal" },
      { task: "Draft blog post", owner: "communications" },
    ],
  },
  {
    title: "Release day",
    tasks: [
      { task: "Publish weights", owner: "engineering" },
      { task: "Publish blog post", owner: "communications" },
      { task: "Answer questions", owner: "research" },
    ],
  },
  {
    title: "Two weeks after",
    tasks: [
      { task: "Fix issues", owner: "engineering" },
      { task: "Track reach", owner: "communications" },
      { task: "Update FAQ", owner: "research" },
    ],
  },
];

// Lines run from the centre node to the four corners. Each line is scaled
// from its own start point, which is the corner of its box nearest the centre.
const lines = [
  { x2: "16.7%", y2: "16.7%", origin: "100% 100%" },
  { x2: "83.3%", y2: "16.7%", origin: "0% 100%" },
  { x2: "16.7%", y2: "83.3%", origin: "100% 0%" },
  { x2: "83.3%", y2: "83.3%", origin: "0% 0%" },
];
---

<section class="chapter bridge" aria-labelledby="bridge-title">
  <div class="wrap">
    <h2 id="bridge-title" class="bridge__title">My part: helping more people understand this research.</h2>

    <div class="net" data-net>
      <svg class="net__lines" aria-hidden="true">
        {lines.map((l) => <line x1="50%" y1="50%" x2={l.x2} y2={l.y2} data-net-line data-origin={l.origin} />)}
      </svg>
      <ul class="net__nodes" role="list" aria-label="Research connects to blog posts, talks, community and releases">
        <li class="net__node net__node--center" data-net-node>Research</li>
        <li class="net__node" style="grid-area: a" data-net-node>Blog posts</li>
        <li class="net__node" style="grid-area: b" data-net-node>Talks</li>
        <li class="net__node" style="grid-area: c" data-net-node>Community</li>
        <li class="net__node" style="grid-area: d" data-net-node>Releases</li>
      </ul>
    </div>
  </div>

  <div class="timeline" data-timeline>
    <div class="wrap timeline__head">
      <p class="timeline__note">A draft I would adapt to your existing process.</p>
    </div>
    <div class="timeline__viewport">
      <ol class="timeline__track wrap" role="list" data-timeline-track>
        {
          phases.map((phase) => (
            <li class="timeline__panel" data-timeline-panel>
              <h3 class="timeline__title">{phase.title}</h3>
              <ul class="timeline__tasks" role="list">
                {phase.tasks.map((t) => (
                  <li class="task">
                    <span class="task__text">{t.task}</span>
                    <span class={`owner owner--${t.owner}`}>{ownerLabel[t.owner]}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .bridge {
    overflow: clip;
  }

  .bridge__title {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 4.2rem);
  }

  /* Network of research outputs */
  .net {
    position: relative;
    max-width: 40rem;
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    aspect-ratio: 4 / 3;
  }

  .net__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .net__lines line {
    stroke: var(--color-amber);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .net__nodes {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    grid-template-areas:
      "a . b"
      ". m ."
      "c . d";
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .net__node {
    place-self: center;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    font-size: clamp(0.85rem, 2.4vw, 1.05rem);
    white-space: nowrap;
  }

  .net__node--center {
    grid-area: m;
    padding: 0.7rem 1.3rem;
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 3vw, 1.45rem);
  }

  /* Release timeline: a vertical list by default */
  .timeline {
    margin-top: clamp(3rem, 8vw, 5rem);
  }

  .timeline__note {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
    color: var(--color-ink-soft);
  }

  .timeline__track {
    display: grid;
    gap: 1rem;
    margin: 0 auto;
    list-style: none;
  }

  @media (min-width: 820px) {
    .timeline__track {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .timeline__panel {
    padding: 1.25rem 1.25rem 1.4rem;
    background: #fffdf8;
    border: 1px solid var(--color-line);
    border-radius: 18px;
  }

  .timeline__step {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-amber-ink);
  }

  .timeline__title {
    margin: 0.2rem 0 1rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .timeline__tasks {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .task {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 0.7rem;
    border-radius: 10px;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
  }

  .task__text {
    font-weight: 500;
  }

  /* Pinned horizontal version, only with the motion script on wide screens */
  @media (min-width: 900px) {
    :global(.motion) .timeline__viewport {
      overflow: hidden;
    }

    :global(.motion) .timeline__track {
      display: flex;
      gap: 2rem;
      width: max-content;
      max-width: none;
      padding-right: 20vw;
    }

    :global(.motion) .timeline__panel {
      width: min(62vw, 36rem);
      padding: 2rem;
    }
  }
</style>
