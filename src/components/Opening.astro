---
import LetterField from "./LetterField.astro";
---

<section class="opening" aria-labelledby="site-title">
  <LetterField seed={11} id="opening-letters" />
  <div class="opening__inner wrap">
    <h1 id="site-title" class="opening__title">Tokenizer-free AI, explained</h1>
    <p class="opening__lede">A work sample for the Intern to Chief of Staff role at Aleph Alpha, by Ved Gawade.</p>
    <div class="opening__actions">
      <a class="btn" href="#reading" data-scroll-link>
        Scroll to explore
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M3.5 8.5 8 13l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
      <a class="btn btn--ghost" href="#demo" data-scroll-link>Try the demo</a>
    </div>
  </div>
</section>

<style>
  .opening {
    position: relative;
    display: grid;
    align-items: center;
    min-height: calc(100svh - 2.6rem);
    overflow: hidden;
    isolation: isolate;
  }

  .opening__inner {
    position: relative;
    z-index: 1;
    padding-block: 5rem;
    text-align: center;
  }

  .opening__title {
    margin: 0 auto;
    max-width: 14ch;
    font-size: clamp(2.9rem, 10vw, 7rem);
    font-weight: 450;
    letter-spacing: -0.025em;
  }

  .opening__lede {
    margin: 1.5rem auto 0;
    max-width: 34rem;
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    color: var(--color-ink-soft);
  }

  .opening__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
</style>
